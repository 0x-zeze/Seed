# ==============================================================================
# Injective Testnet Deployment Environment Configuration
# ==============================================================================
# INSTRUCTIONS:
# 1. Copy this file to .env:
#    cp .env.example .env
# 2. Populate with your testnet wallet mnemonic.
# 3. Ensure your wallet has testnet INJ from https://testnet.faucet.injective.network/
# 4. NEVER COMMIT .env TO GIT (enforced in .gitignore)
# ==============================================================================

# Deployer wallet mnemonic phrase (12 or 24 words, space separated)
# The wallet must have testnet INJ for gas, denom creation fee (1 INJ), and test deposits.
MNEMONIC="word1 word2 word3 word4 word5 word6 word7 word8 word9 word10 word11 word12"

# Injective Network target - MUST BE "testnet"
# Security guards hard-abort if set to any other value or if pointing to mainnet.
INJECTIVE_NETWORK="testnet"

# Comma-separated list of allowed derivative market IDs (REQUIRED, NO DEFAULT)
# The instantiate script will fail if this variable is missing or empty.
# Example active Injective Testnet market (GOLD/USDT PERP):
# 0x8f002b45cb287a4c3ecb89174ee42a7e933178d89c7eea94dbed8dc5dfd35d23
MARKET_IDS="0x8f002b45cb287a4c3ecb89174ee42a7e933178d89c7eea94dbed8dc5dfd35d23"

# Subdenom for TokenFactory test SEED token (default: "seed")
# Full denom format created on chain: factory/<deployer_address>/<SEED_SUBDENOM>
SEED_SUBDENOM="seed"
